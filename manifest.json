{
  "manifest_version": 3,
  "name": "Gemini Web Bridge",
  "version": "1.0.0",
  "description": "Chrome Extension API bridge for interacting with an open Gemini Web UI tab",
  "permissions": [
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "dist/popup.html",
    "default_title": "Ask Gemini"
  }
}
